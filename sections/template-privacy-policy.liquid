<!-- sections/privacy-policy.liquid -->

<div class="max-w-3xl mx-auto p-6">
  <h1 class="text-4xl font-bold my-4">{{ section.settings.title }}</h1>
  <div class="prose lg:prose-xl">
    <p>{{ section.settings.introduction }}</p>
    
    <h2 class="text-2xl font-semibold my-2">Information Collection</h2>
    <p>{{ section.settings.information_collection }}</p>
    
    <h2 class="text-2xl font-semibold my-2">Information Usage</h2>
    <p>{{ section.settings.information_usage }}</p>
    
    <h2 class="text-2xl font-semibold my-2">Information Protection</h2>
    <p>{{ section.settings.information_protection }}</p>
    
    <h2 class="text-2xl font-semibold my-2">Cookies</h2>
    <p>{{ section.settings.cookies }}</p>
    
    <h2 class="text-2xl font-semibold my-2">Consent</h2>
    <p>{{ section.settings.consent }}</p>
    
    <h2 class="text-2xl font-semibold my-2">Changes to Our Privacy Policy</h2>
    <p>{{ section.settings.changes_policy }}</p>
    
    <h2 class="text-2xl font-semibold my-2">Contacting Us</h2>
    <p>{{ section.settings.contact_info }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Privacy Policy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Privacy Policy",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "introduction",
      "default": "Welcome to our Privacy Policy page. We value your privacy and strive to protect your personal information. Below is our Privacy Policy:",
      "label": "Introduction"
    },
    {
      "type": "textarea",
      "id": "information_collection",
      "default": "We collect information from you when you register on our site, place an order, subscribe to our newsletter, or fill out a form.",
      "label": "Information Collection"
    },
    {
      "type": "textarea",
      "id": "information_usage",
      "default": "Any of the information we collect from you may be used in one of the following ways: To personalize your experience, To improve our website, To improve customer service, To process transactions, To send periodic emails.",
      "label": "Information Usage"
    },
    {
      "type": "textarea",
      "id": "information_protection",
      "default": "We implement a variety of security measures to maintain the safety of your personal information.",
      "label": "Information Protection"
    },
    {
      "type": "textarea",
      "id": "cookies",
      "default": "We use cookies to understand and save your preferences for future visits and compile aggregate data about site traffic and site interaction so that we can offer better site experiences and tools in the future.",
      "label": "Cookies"
    },
    {
      "type": "textarea",
      "id": "consent",
      "default": "By using our site, you consent to our online privacy policy.",
      "label": "Consent"
    },
    {
      "type": "textarea",
      "id": "changes_policy",
      "default": "If we decide to change our privacy policy, we will post those changes on this page.",
      "label": "Changes to Our Privacy Policy"
    },
    {
      "type": "textarea",
      "id": "contact_info",
      "default": "If there are any questions regarding this privacy policy, you may contact us using the information below: Shop Name, Address, City, State, ZIP, Email: info@yourshop.com, Phone: (123) 456-7890.",
      "label": "Contacting Us"
    }
  ]
}
{% endschema %}
